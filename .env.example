# Copy to `.env.local` for local development. Never commit real secrets.
# On Vercel: set the same keys in Project → Settings → Environment Variables
# (Production + Preview as appropriate).

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
# Prefer the publishable key; anon key is an accepted fallback in code.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push / VAPID (required for browser push; in-app notifications work without) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only
VAPID_PRIVATE_KEY=
# Optional contact URI for VAPID (mailto: or https:)
# VAPID_SUBJECT=mailto:support@your-domain.com
# Optional: absolute site URL for sitemap (e.g. https://app.example.com)
# NEXT_PUBLIC_APP_URL=